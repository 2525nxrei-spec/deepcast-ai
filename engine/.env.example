# Deepcast Engine — Environment Variables
# Copy this file to .env and fill in your values.

# Ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL_GENERATE=llama3
OLLAMA_MODEL_EVALUATE=gemma2

# Database
DB_PATH=./data/deepcast.db

# Quality control
QUALITY_THRESHOLD=80
MAX_RETRIES=3

# Scheduler
SCHEDULE_INTERVAL_HOURS=1

# API
API_SECRET_KEY=change-me-to-a-real-secret
CORS_ORIGINS=["https://deepcast-ai.com","http://localhost:3000"]

# Logging
LOG_LEVEL=INFO
